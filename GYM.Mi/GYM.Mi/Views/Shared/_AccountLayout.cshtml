<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GYM.Mi</title>

  
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    <style>
       
        .navbar a,
        .nav-links a {
            color: var(--text-muted) !important;
            text-decoration: none !important;
        }

            .nav-links a:hover {
                color: var(--text-main) !important;
            }

        .logo {
            color: var(--text-main) !important;
            text-decoration: none !important;
        }

            .logo span {
                color: var(--accent) !important;
            }

        /* Both buttons — same halka orange, Bootstrap override */
        .nav-actions .btn-outline,
        .nav-actions .btn-primary {
            background: rgba(255, 77, 46, 0.15) !important;
            border: 1px solid var(--accent) !important;
            color: #ffffff !important;
            text-decoration: none !important;
            box-shadow: none !important;
            transform: none !important;
        }

            .nav-actions .btn-outline:hover,
            .nav-actions .btn-primary:hover {
                background: rgba(255, 77, 46, 0.32) !important;
                border-color: var(--accent) !important;
                color: #ffffff !important;
                transform: translateY(-1px) !important;
                box-shadow: none !important;
            }

    
        body {
            min-height: 100vh;
            background: var(--bg-main);
        }

        .auth-overlay {
            min-height: 100vh;
            padding-top: 100px;
            padding-bottom: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: radial-gradient(circle at 70% 20%, rgba(255, 77, 46, 0.15), transparent 30%), radial-gradient(circle at 20% 80%, rgba(215, 255, 63, 0.08), transparent 25%), linear-gradient(135deg, #12051f 0%, #2b0a3d 55%, #170622 100%);
        }

            .auth-overlay::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(rgba(18, 5, 31, 0.88), rgba(18, 5, 31, 0.88)), url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1600&q=80");
                background-size: cover;
                background-position: center;
            }

        
        .auth-card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 480px;
            background: rgba(36, 16, 51, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(20px);
        }

        .auth-card-header {
            padding: 32px 36px 24px;
            background: linear-gradient(135deg, rgba(255, 77, 46, 0.25), rgba(75, 20, 95, 0.4));
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            position: relative;
        }

            .auth-card-header h4 {
                color: #ffffff;
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .auth-card-header p {
                color: var(--text-muted);
                font-size: 14px;
                margin: 0;
            }

        /* Close button */
        .auth-close {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.20);
            color: #fff !important;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none !important;
            transition: 0.2s ease;
            line-height: 1;
            z-index: 20;
            cursor: pointer;
        }

            .auth-close:hover {
                background: rgba(255, 77, 46, 0.5);
                color: #fff !important;
            }

      
        .auth-card-body {
            padding: 30px 36px 36px;
        }

            .auth-card-body h5 {
                color: var(--text-muted);
                font-size: 13px;
                font-weight: 500;
                text-align: center;
                margin-bottom: 22px;
                letter-spacing: 0.3px;
            }

            /* Input fields */
            .auth-card-body .form-floating {
                margin-bottom: 14px;
            }

            .auth-card-body .form-control {
                background: rgba(255, 255, 255, 0.06) !important;
                border: 1px solid rgba(255, 255, 255, 0.14) !important;
                color: #ffffff !important;
                border-radius: 12px !important;
                height: 58px !important;
                font-size: 15px !important;
                padding: 22px 16px 6px 16px !important;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .auth-card-body .form-control:focus {
                    background: rgba(255, 255, 255, 0.09) !important;
                    border-color: rgba(255, 77, 46, 0.55) !important;
                    box-shadow: 0 0 0 3px rgba(255, 77, 46, 0.12) !important;
                    color: #ffffff !important;
                    outline: none !important;
                }

                /* Autofill dark fix */
                .auth-card-body .form-control:-webkit-autofill,
                .auth-card-body .form-control:-webkit-autofill:hover,
                .auth-card-body .form-control:-webkit-autofill:focus {
                    -webkit-box-shadow: 0 0 0 100px rgba(36, 16, 51, 1) inset !important;
                    -webkit-text-fill-color: #ffffff !important;
                    border-color: rgba(255, 255, 255, 0.14) !important;
                }

            /* Floating label */
            .auth-card-body .form-floating label {
                color: #9f8ab3 !important;
                font-size: 14px !important;
                padding-top: 18px !important;
            }

            .auth-card-body .form-floating > .form-control:focus ~ label,
            .auth-card-body .form-floating > .form-control:not(:placeholder-shown) ~ label {
                color: #FF4D2E !important;
                opacity: 1 !important;
            }

        /* Submit button */
        .btn-auth {
            display: block;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: 700;
            font-size: 15px;
            background: linear-gradient(135deg, #FF4D2E, #ff7a5c);
            color: #fff !important;
            box-shadow: 0 8px 24px rgba(255, 77, 46, 0.32);
            transition: 0.25s ease;
            cursor: pointer;
            text-align: center;
            text-decoration: none !important;
            margin-top: 4px;
        }

            .btn-auth:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 32px rgba(255, 77, 46, 0.44);
            }

        /* Remember me */
        .auth-card-body .form-check {
            margin-bottom: 18px;
        }

        .auth-card-body .form-check-input {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.28);
            width: 18px;
            height: 18px;
            margin-top: 2px;
        }

            .auth-card-body .form-check-input:checked {
                background-color: #FF4D2E;
                border-color: #FF4D2E;
            }

        .auth-card-body .form-check-label {
            color: var(--text-muted) !important;
            font-size: 14px;
            margin-left: 6px;
        }

        /* Validation */
        .auth-card-body .text-danger {
            color: #ff8a7a !important;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }

        /* Divider */
        .auth-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.07);
            margin: 22px 0;
        }

        /* Switch links */
        .auth-switch {
            text-align: center;
            color: var(--text-muted) !important;
            font-size: 14px;
            margin-top: 10px;
        }

            .auth-switch a {
                color: var(--accent-2) !important;
                text-decoration: none !important;
                font-weight: 600;
            }

                .auth-switch a:hover {
                    text-decoration: underline !important;
                }
    </style>

        @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="navbar">
        <div class="container nav-content">
            <a asp-controller="Home" asp-action="Index" class="logo">Gym<span>Mi</span></a>
            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="/#features">Features</a>
                <a href="/#membership">Membership</a>
                <a href="/#trainers">Trainers</a>
                <a href="/#blog">Blog</a>
                <a href="/#contact">Contact</a>
            </nav>
            <div class="nav-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline">Register</a>
            </div>
        </div>
    </header>

    <div class="auth-overlay">
        <div class="auth-card">
            <a asp-controller="Home" asp-action="Index" class="auth-close">&#x2715;</a>
            @RenderBody()
        </div>
    </div>

   
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

