@model GYM.Mi.Models.HomeIndexModel
@{
    ViewData["Title"] = "Welcome";
    Layout = "_LandingLayout";
}

<main>
    <section class="hero" id="home">
        <div class="container hero-content">
            <div>
                <div class="hero-badge">
                    <span class="dot"></span> Smart Fitness & Gym Management
                </div>

                <h1>Manage Your Gym. Build Stronger <span>Members.</span></h1>

                <p>
                    A modern gym management platform for handling memberships, trainers,
                    workout schedules, attendance, payments, and member progress from one secure system.
                </p>

                <div class="hero-buttons">
                    <a href="#features" class="btn btn-primary">Explore Features</a>
                    <a href="#membership" class="btn btn-outline">View Membership</a>
                </div>

                <div class="stats">
                    <div class="stat-card">
                        <h3>500+</h3>
                        <p>Active Members</p>
                    </div>

                    <div class="stat-card">
                        <h3>20+</h3>
                        <p>Certified Trainers</p>
                    </div>

                    <div class="stat-card">
                        <h3>95%</h3>
                        <p>Member Satisfaction</p>
                    </div>
                </div>
            </div>

            <div class="hero-panel">
                <div class="dashboard-card">
                    <div class="dashboard-top">
                        <div>
                            <p class="mini-title">Member Dashboard</p>
                            <h3>Today’s Fitness Plan</h3>
                        </div>

                        <span class="status">Active</span>
                    </div>

                    <div class="progress-box">
                        <div class="progress-row">
                            <span>Weekly Progress</span>
                            <strong>76%</strong>
                        </div>

                        <div class="bar">
                            <span></span>
                        </div>
                    </div>

                    <div class="schedule-list">
                        <div class="schedule-item">
                            <div>
                                <strong>Strength Training</strong>
                                <small>10:00 AM - Trainer Masud Rana</small>
                            </div>

                            <span class="tag">Today</span>
                        </div>

                        <div class="schedule-item">
                            <div>
                                <strong>Cardio Session</strong>
                                <small>05:30 PM - Zone B</small>
                            </div>

                            <span class="tag">Booked</span>
                        </div>

                        <div class="schedule-item">
                            <div>
                                <strong>Payment Status</strong>
                                <small>Premium Plan Renewal</small>
                            </div>

                            <span class="tag">Paid</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="features" id="features">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Core Features</p>
                <h2>Everything a modern gym needs in one platform.</h2>
                <p>
                    The system connects members, trainers, and administrators through a clean and easy digital workflow.
                </p>
            </div>

            <div class="feature-grid">
                <div class="feature-card">
                    <div class="icon">🏋️</div>
                    <h3>Membership Management</h3>
                    <p>Register members, assign plans, track renewals, and manage membership status efficiently.</p>
                </div>

                <div class="feature-card">
                    <div class="icon">👨‍🏫</div>
                    <h3>Trainer Management</h3>
                    <p>Show trainer profiles, specialties, assigned members, and available training sessions.</p>
                </div>

                <div class="feature-card">
                    <div class="icon">📅</div>
                    <h3>Workout Schedule</h3>
                    <p>Members can view daily routines, class timing, and training session details after login.</p>
                </div>

                <div class="feature-card">
                    <div class="icon">✅</div>
                    <h3>Attendance Tracking</h3>
                    <p>Admins can monitor attendance and identify active or inactive gym members.</p>
                </div>

                <div class="feature-card">
                    <div class="icon">💳</div>
                    <h3>Payment Records</h3>
                    <p>Keep membership payment history, due status, and renewal information organized.</p>
                </div>

                <div class="feature-card">
                    <div class="icon">📈</div>
                    <h3>Progress Tracking</h3>
                    <p>Track BMI, weight changes, workout consistency, and personal fitness goals.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="membership">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Membership Plans</p>
                <h2>Choose a plan that matches your fitness goal.</h2>
                <p>
                    Select your preferred plan during registration. After cash payment at the gym counter,
                    admin will activate your membership.
                </p>
            </div>

            <div class="plans-grid">

                <div class="plan-card">
                    <h3>Basic</h3>
                    <p>Best for members who need regular gym access and membership tracking.</p>

                    <div class="price">
                        ৳1500 <span>/ month</span>
                    </div>

                    <ul>
                        <li>Gym access</li>
                        <li>Profile access</li>
                        <li>Payment history</li>
                        <li>Membership status tracking</li>
                    </ul>

                    <a asp-controller="Account"
                       asp-action="Register"
                       asp-route-plan="Basic"
                       class="btn btn-outline">
                        Choose Basic
                    </a>
                </div>

                <div class="plan-card featured">
                    <span class="popular">Popular</span>

                    <h3>Standard</h3>
                    <p>Includes Basic features plus AI fitness support and workout guidance.</p>

                    <div class="price">
                        ৳4000 <span>/ 3 months</span>
                    </div>

                    <ul>
                        <li>Everything in basic</li>
                        <li>AI fitness coach</li>
                        <li>Workout guidance</li>
                    </ul>

                    <a asp-controller="Account"
                       asp-action="Register"
                       asp-route-plan="Standard"
                       class="btn btn-primary">
                        Choose Standard
                    </a>
                </div>

                <div class="plan-card">
                    <h3>Premium</h3>
                    <p>Includes Standard features plus personal trainer support and priority guidance.</p>

                    <div class="price">
                        ৳7500 <span>/ 6 months</span>
                    </div>

                    <ul>
                        <li>Everything in standard</li>
                        <li>Personal trainer support</li>
                        <li>Priority support</li>
                        <li>Advanced progress guidance</li>
                    </ul>

                    <a asp-controller="Account"
                       asp-action="Register"
                       asp-route-plan="Premium"
                       class="btn btn-outline">
                        Choose Premium
                    </a>
                </div>

            </div>
        </div>
    </section>

    <section class="how-it-works">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">How It Works</p>
                <h2>Simple flow from registration to fitness progress.</h2>
                <p>The welcome page should clearly explain what happens after a new user joins the system.</p>
            </div>

            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h3>Create Account</h3>
                    <p>User registers with basic details and secure authentication.</p>
                </div>

                <div class="step-card">
                    <div class="step-number">2</div>
                    <h3>Select Plan</h3>
                    <p>User chooses a membership plan based on fitness need.</p>
                </div>

                <div class="step-card">
                    <div class="step-number">3</div>
                    <h3>Access Dashboard</h3>
                    <p>After login, users can view schedules, attendance, and payments.</p>
                </div>

                <div class="step-card">
                    <div class="step-number">4</div>
                    <h3>Track Progress</h3>
                    <p>Members monitor goals and stay connected with trainers.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="trainers">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Our Trainers</p>
                <h2>Professional trainers for every fitness level.</h2>
                <p>
                    Meet our featured trainers who help members achieve their fitness goals with proper guidance.
                </p>
            </div>

            @if (Model != null && Model.Trainers != null && Model.Trainers.Any())
            {
                <div class="trainer-grid">
                    @foreach (var trainer in Model.Trainers)
                    {
                        var specialization = string.IsNullOrWhiteSpace(trainer.Specialization)
                        ? "Fitness Trainer"
                        : trainer.Specialization;

                        var experienceText = trainer.ExperienceYears.HasValue && trainer.ExperienceYears.Value > 0
                        ? $" · {trainer.ExperienceYears.Value} year(s) experience"
                        : string.Empty;

                        var shortBio = string.IsNullOrWhiteSpace(trainer.ShortBio)
                        ? "Dedicated trainer focused on helping members improve strength, fitness, and confidence."
                        : trainer.ShortBio;

                        var trainerInitial = string.IsNullOrWhiteSpace(trainer.FullName)
                        ? "T"
                        : trainer.FullName.Substring(0, 1).ToUpper();

                        <div class="trainer-card">
                            @if (!string.IsNullOrWhiteSpace(trainer.ImageUrl))
                            {
                                <div class="trainer-photo"
                                     style="background-image:url('@Url.Content(trainer.ImageUrl)');">
                                </div>
                            }
                            else
                            {
                                <div class="trainer-photo"
                                     style="background: linear-gradient(135deg,#667eea,#764ba2); display:flex; align-items:center; justify-content:center; color:white; font-size:42px; font-weight:800;">
                                    @trainerInitial
                                </div>
                            }

                            <small>@specialization@experienceText</small>
                            <h3>@trainer.FullName</h3>
                            <p>@shortBio</p>
                        </div>
                    }
                </div>

                <div style="text-align:center; margin-top: 42px;">
                    <a asp-controller="Home"
                       asp-action="Trainers"
                       class="btn btn-primary">
                        View All Trainers
                    </a>
                </div>
            }
            else
            {
                <div class="trainer-grid">
                    <div class="trainer-card">
                        <div class="trainer-photo"
                             style="background: linear-gradient(135deg,#667eea,#764ba2); display:flex; align-items:center; justify-content:center; color:white; font-size:42px; font-weight:800;">
                            T
                        </div>

                        <small>Fitness Trainer</small>
                        <h3>No featured trainers yet</h3>
                        <p>
                            Featured trainers will appear here once admin adds trainer profiles and enables public website visibility.
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="blog" id="blog">
        <div class="container">
            <div class="section-header">
                <p class="eyebrow">Fitness Blog</p>
                <h2>Latest fitness tips for our members.</h2>
                <p>
                    Read helpful articles about workouts, nutrition, healthy habits,
                    and smart fitness progress.
                </p>
            </div>

            @if (Model != null && Model.Blogs != null && Model.Blogs.Any())
            {
                <div class="blog-grid">
                    @foreach (var blog in Model.Blogs)
                    {
                        <div class="blog-card">

                            @if (!string.IsNullOrWhiteSpace(blog.FeaturedImageUrl))
                            {
                                <div style="
                                    height: 190px;
                                    margin: -6px -6px 22px -6px;
                                    border-radius: 18px;
                                    background-image: url('@blog.FeaturedImageUrl');
                                    background-size: cover;
                                    background-position: center;">
                                </div>
                            }

                            <p class="date">
                                @(blog.PublishedAt.HasValue
                                    ? blog.PublishedAt.Value.ToString("dd MMM yyyy")
                                    : "Fitness Tips")
                            </p>

                            <h3>@blog.Title</h3>

                            <p>
                                @blog.ShortDescription
                            </p>

                            <div style="margin-top: 22px;">
                                <a href="/blog/@blog.Slug" class="btn btn-outline">
                                    Read More
                                </a>
                            </div>

                        </div>
                    }
                </div>

                <div style="text-align:center; margin-top: 42px;">
                    <a href="/blog" class="btn btn-primary">
                        View All Blogs
                    </a>
                </div>
            }
            else
            {
                <div class="blog-grid">
                    <div class="blog-card">
                        <p class="date">Fitness Tips</p>
                        <h3>No published blog posts yet</h3>
                        <p>
                            New workout tips, nutrition guides, and health articles will appear here soon.
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>

