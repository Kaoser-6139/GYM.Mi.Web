@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <script>
        $(function () {

            function getGenderBadgeClass(value) {
                const gender = (value || "").toLowerCase();

                if (gender === "male") {
                    return "gender-male";
                }

                if (gender === "female") {
                    return "gender-female";
                }

                return "gender-default";
            }

            function getGoalBadgeClass(value) {
                const goal = (value || "").toLowerCase();

                if (goal.includes("weight") || goal.includes("loss") || goal.includes("fat")) {
                    return "goal-weight-loss";
                }

                if (goal.includes("muscle") || goal.includes("gain") || goal.includes("strength")) {
                    return "goal-muscle-gain";
                }

                if (goal.includes("fitness") || goal.includes("fit") || goal.includes("endurance")) {
                    return "goal-fitness";
                }

                return "goal-default";
            }

            function getMembershipBadgeClass(value) {
                const membership = (value || "").toLowerCase();

                if (membership.includes("premium") && membership.includes("active")) {
                    return "membership-premium";
                }

                if (membership.includes("standard") && membership.includes("active")) {
                    return "membership-standard";
                }

                if (membership.includes("active")) {
                    return "membership-active";
                }

                if (membership.includes("pending")) {
                    return "membership-pending";
                }

                if (membership.includes("expired")) {
                    return "membership-expired";
                }

                return "membership-none";
            }

            const usersTable = $("#users").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                scrollX: false,
                autoWidth: false,

                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, 'All']
                ],

                layout: {
                    topStart: 'buttons',
                    topEnd: 'search',
                },

                buttons: [
                    {
                        extend: 'copy',
                        exportOptions: {
                            columns: ':not(:last-child)'
                        }
                    },
                    {
                        extend: 'csv',
                        exportOptions: {
                            columns: ':not(:last-child)'
                        }
                    },
                    {
                        extend: 'excel',
                        exportOptions: {
                            columns: ':not(:last-child)'
                        }
                    },
                    {
                        extend: 'pdf',
                        exportOptions: {
                            columns: ':not(:last-child)'
                        }
                    },
                    {
                        extend: 'print',
                        exportOptions: {
                            columns: ':not(:last-child)'
                        }
                    }
                ],

                ajax: {
                    url: "/Admin/Users/GetUsersJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        d.SearchItem = {};
                        d.MembershipFilter = $('#membershipFilter').val();
                        d.MembershipPlanFilter = $('#membershipPlanFilter').val();

                        return JSON.stringify(d);
                    }
                },

                columns: [
                    {
                        data: 0,
                        render: function (data) {
                            return `
                                <span class="user-name-text">
                                    ${data || "N/A"}
                                </span>
                            `;
                        }
                    },
                    {
                        data: 1,
                        orderable: false,
                        render: function (data) {
                            return `
                                <span class="user-muted-text">
                                    ${data || "N/A"}
                                </span>
                            `;
                        }
                    },
                    {
                        data: 2,
                        orderable: false,
                        render: function (data) {
                            return data || "N/A";
                        }
                    },
                    {
                        data: 3,
                        orderable: false,
                        render: function (data) {
                            const badgeClass = getGenderBadgeClass(data);

                            return `
                                <span class="badge user-gender-badge ${badgeClass}">
                                    ${data || "N/A"}
                                </span>
                            `;
                        }
                    },
                    {
                        data: 4,
                        orderable: false,
                        render: function (data) {
                            const badgeClass = getGoalBadgeClass(data);

                            return `
                                <span class="badge user-goal-badge ${badgeClass}">
                                    ${data || "N/A"}
                                </span>
                            `;
                        }
                    },
                    {
                        data: 5,
                        orderable: false,
                        render: function (data) {
                            const badgeClass = getMembershipBadgeClass(data);

                            return `
                                <span class="badge user-membership-badge ${badgeClass}">
                                    ${data || "No Membership"}
                                </span>
                            `;
                        }
                    },
                    {
                        data: 6,
                        orderable: false,
                        render: function (data) {
                            return data || "N/A";
                        }
                    },
                    {
                        data: 7,
                        orderable: false,
                        searchable: false,
                        className: "text-center user-action-column",
                        render: function (data) {
                            return `
                                <div class="user-action-wrapper">
                                    <a href="/Admin/Users/Profile/${data}"
                                       class="btn btn-primary btn-sm user-action-btn user-profile-btn"
                                       title="View Profile">
                                        <i class="bi bi-person"></i>
                                        Profile
                                    </a>

                                    <a href="/Admin/Users/Update/${data}"
                                       class="btn btn-warning btn-sm user-action-btn user-edit-btn"
                                       title="Edit User">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-sm show-bs-modal user-action-btn user-delete-btn"
                                            data-id="${data}"
                                            title="Delete User">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </button>
                                </div>
                            `;
                        }
                    }
                ]
            });

            $('#membershipFilter, #membershipPlanFilter').on('change', function () {
                usersTable.ajax.reload();
            });

            $('#users').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");
                let deleteModalElement = document.getElementById("modal-delete");
                let deleteModal = $("#modal-delete");

                deleteModal.find('.modal-body p').text('Are you sure you want to delete this user?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/admin/users/delete');

                if (deleteModalElement && typeof bootstrap !== "undefined") {
                    const modal = bootstrap.Modal.getOrCreateInstance(deleteModalElement);
                    modal.show();
                } else {
                    deleteModal.modal('show');
                }
            });

            $('#delete-button').click(function () {
                $('#delete-form').submit();
            });
        });
    </script>
} *@