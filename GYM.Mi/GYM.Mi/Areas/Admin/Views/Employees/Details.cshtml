@model GYM.Domain.Entities.Employee

@{
    ViewData["Title"] = "Employee Details";

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
    var isTrainer = string.Equals(Model.Department, "Trainer", StringComparison.OrdinalIgnoreCase);

    string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "N/A" : value;
    }

    string DisplayNullableInt(int? value)
    {
        return value.HasValue ? value.Value.ToString() : "N/A";
    }

    string DisplayNullableBool(bool? value)
    {
        if (!value.HasValue)
        {
            return "N/A";
        }

        return value.Value ? "Yes" : "No";
    }

    string DisplayBool(bool value)
    {
        return value ? "Yes" : "No";
    }
}

@section Styles
{
    <style>
        .employee-details-card {
            border: none;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        }

        .employee-details-header {
            background: linear-gradient(135deg,#667eea,#764ba2);
            color: white;
            padding: 24px;
        }

            .employee-details-header h5 {
                color: white;
                font-size: 24px;
                font-weight: 700;
                margin: 0;
            }

        .employee-details-subtitle {
            color: rgba(255, 255, 255, 0.85);
            margin-top: 6px;
            font-size: 15px;
        }

        .employee-profile-summary {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
            background: #ffffff;
            margin-bottom: 24px;
        }

        .employee-avatar-box {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: linear-gradient(135deg,#667eea,#764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .employee-summary-image {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e5e7eb;
            background: #f8f9fa;
            flex-shrink: 0;
        }

        .employee-profile-name {
            font-size: 24px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 6px;
        }

        .employee-profile-meta {
            color: #6b7280;
            font-size: 15px;
        }

        .employee-badge {
            padding: 7px 13px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .details-section-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 22px;
            background: #ffffff;
        }

        .details-section-header {
            background: #f8f9fa;
            padding: 15px 18px;
            border-bottom: 1px solid #e5e7eb;
        }

            .details-section-header h6 {
                margin: 0;
                font-size: 17px;
                font-weight: 800;
                color: #111827;
            }

        .details-info-table {
            margin-bottom: 0;
        }

            .details-info-table th {
                width: 260px;
                color: #374151;
                font-weight: 700;
                background: #fcfcfc;
                vertical-align: middle;
            }

            .details-info-table td {
                color: #111827;
                vertical-align: middle;
            }

        .employee-photo-preview {
            width: 140px;
            height: 140px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #d1d5db;
            background: #f8f9fa;
        }

        .employee-photo-empty {
            width: 140px;
            height: 140px;
            border-radius: 10px;
            border: 1px dashed #d1d5db;
            background: #f8f9fa;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
        }

        .trainer-profile-note {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 14px;
        }

        .short-bio-text {
            white-space: pre-line;
            line-height: 1.6;
        }

        .employee-details-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 18px 24px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        @@media (max-width: 768px) {
            .employee-details-header .d-flex,
            .employee-profile-summary .d-flex,
            .employee-details-footer {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 14px;
            }

                .employee-details-footer .btn {
                    width: 100%;
                }

            .details-info-table th {
                width: 45%;
            }
        }
    </style>
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Employee Details</h3>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Employees" asp-action="Index">Employees</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="card employee-details-card">

            <div class="employee-details-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>
                            <i class="bi bi-person-lines-fill me-2"></i>
                            @fullName
                        </h5>

                        <div class="employee-details-subtitle">
                            Complete employee profile and employment information
                        </div>
                    </div>

                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success employee-badge">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger employee-badge">Inactive</span>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body">

                <partial name="_ResponsePartial" />

                <div class="employee-profile-summary">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="Employee Image"
                                 class="employee-summary-image" />
                        }
                        else
                        {
                            <div class="employee-avatar-box">
                                @(string.IsNullOrWhiteSpace(Model.FirstName) ? "E" : Model.FirstName.Substring(0, 1).ToUpper())
                            </div>
                        }

                        <div>
                            <div class="employee-profile-name">
                                @fullName
                            </div>

                            <div class="employee-profile-meta">
                                <span class="me-3">
                                    <i class="bi bi-briefcase me-1"></i>
                                    @Display(Model.Department)
                                </span>

                                <span class="me-3">
                                    <i class="bi bi-clock me-1"></i>
                                    @Display(Model.WorkShift)
                                </span>

                                <span>
                                    <i class="bi bi-telephone me-1"></i>
                                    @Display(Model.PhoneNumber)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-image me-2"></i>
                            Employee Photo
                        </h6>
                    </div>

                    <div class="p-3">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="Employee Image"
                                 class="employee-photo-preview" />
                        }
                        else
                        {
                            <div class="employee-photo-empty">
                                No Image
                            </div>
                        }
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-person me-2"></i>
                            Personal Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>First Name</th>
                                    <td>@Display(Model.FirstName)</td>
                                </tr>
                                <tr>
                                    <th>Last Name</th>
                                    <td>@Display(Model.LastName)</td>
                                </tr>
                                <tr>
                                    <th>Date of Birth</th>
                                    <td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Gender</th>
                                    <td>@Display(Model.Gender)</td>
                                </tr>
                                <tr>
                                    <th>Phone Number</th>
                                    <td>@Display(Model.PhoneNumber)</td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>@Display(Model.Email)</td>
                                </tr>
                                <tr>
                                    <th>Address</th>
                                    <td>@Display(Model.Address)</td>
                                </tr>
                                <tr>
                                    <th>Religion</th>
                                    <td>@Display(Model.Religion)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-briefcase me-2"></i>
                            Employment Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Hire Date</th>
                                    <td>@Model.HireDate.ToString("dd MMM yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Department</th>
                                    <td>
                                        <span class="badge bg-primary employee-badge">
                                            @Display(Model.Department)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Work Shift</th>
                                    <td>@Display(Model.WorkShift)</td>
                                </tr>
                                <tr>
                                    <th>Salary</th>
                                    <td>@Model.Salary.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success employee-badge">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger employee-badge">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-heart-pulse me-2"></i>
                            Emergency / Medical Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Emergency Contact</th>
                                    <td>@Display(Model.EmergencyContact)</td>
                                </tr>
                                <tr>
                                    <th>Blood Group</th>
                                    <td>@Display(Model.BloodGroup)</td>
                                </tr>
                                <tr>
                                    <th>CPR Certified</th>
                                    <td>@DisplayNullableBool(Model.CPRCertified)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-award me-2"></i>
                            Professional Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Qualification</th>
                                    <td>@Display(Model.Qualification)</td>
                                </tr>
                                <tr>
                                    <th>Specialization</th>
                                    <td>@Display(Model.Specialization)</td>
                                </tr>
                                <tr>
                                    <th>Experience Years</th>
                                    <td>@DisplayNullableInt(Model.ExperienceYears)</td>
                                </tr>
                                <tr>
                                    <th>License Number</th>
                                    <td>@Display(Model.LicenseNumber)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (isTrainer)
                {
                    <div class="details-section-card">
                        <div class="details-section-header">
                            <h6>
                                <i class="bi bi-person-badge me-2"></i>
                                Public Trainer Profile
                            </h6>
                        </div>

                        <div class="p-3">
                            <div class="trainer-profile-note">
                                This information controls how the trainer appears on the public website.
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered details-info-table">
                                <tbody>
                                    <tr>
                                        <th>Featured on Website</th>
                                        <td>
                                            @if (Model.ShowOnLandingPage)
                                            {
                                                <span class="badge bg-success employee-badge">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary employee-badge">No</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Trainer Display Order</th>
                                        <td>@Model.DisplayOrder</td>
                                    </tr>
                                    <tr>
                                        <th>Short Bio</th>
                                        <td class="short-bio-text">@Display(Model.ShortBio)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-bank me-2"></i>
                            Bank Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Bank Account</th>
                                    <td>@Display(Model.BankAccount)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="employee-details-footer">
                <a asp-area="Admin"
                   asp-controller="Employees"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Employees
                </a>

                <a asp-area="Admin"
                   asp-controller="Employees"
                   asp-action="Update"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="fas fa-pencil-alt me-1"></i>
                    Edit Employee
                </a>
            </div>

        </div>

    </div>
</div>