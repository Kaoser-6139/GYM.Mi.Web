@model GYM.Domain.Entities.Equipment

@{
    ViewData["Title"] = "Equipment Details";

    string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "N/A" : value;
    }

    string DisplayDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd MMM yyyy") : "N/A";
    }

    string DisplayNumber(int value)
    {
        return value.ToString();
    }

    string GetAvailabilityBadgeClass(string? value)
    {
        var status = value?.ToLower() ?? "";

        if (status.Contains("available"))
        {
            return "bg-success";
        }

        if (status.Contains("maintenance"))
        {
            return "bg-warning text-dark";
        }

        if (status.Contains("unavailable") || status.Contains("not available"))
        {
            return "bg-danger";
        }

        return "bg-secondary";
    }

    string GetConditionBadgeClass(string? value)
    {
        var condition = value?.ToLower() ?? "";

        if (condition.Contains("excellent") || condition.Contains("new") || condition.Contains("good"))
        {
            return "bg-success";
        }

        if (condition.Contains("fair"))
        {
            return "bg-info text-dark";
        }

        if (condition.Contains("poor") || condition.Contains("damaged"))
        {
            return "bg-danger";
        }

        return "bg-secondary";
    }
}

@section Styles
{
    <style>
        .equipment-details-card {
            border: none;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        }

        .equipment-details-header {
            background: linear-gradient(135deg,#667eea,#764ba2);
            color: white;
            padding: 24px;
        }

            .equipment-details-header h5 {
                color: white;
                font-size: 24px;
                font-weight: 700;
                margin: 0;
            }

        .equipment-details-subtitle {
            color: rgba(255, 255, 255, 0.85);
            margin-top: 6px;
            font-size: 15px;
        }

        .equipment-summary-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
            background: #ffffff;
            margin-bottom: 24px;
        }

        .equipment-icon-box {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: linear-gradient(135deg,#667eea,#764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .equipment-summary-name {
            font-size: 24px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 6px;
        }

        .equipment-summary-meta {
            color: #6b7280;
            font-size: 15px;
        }

        .equipment-badge {
            padding: 7px 13px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .details-section-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 22px;
            background: #ffffff;
        }

        .details-section-header {
            background: #f8f9fa;
            padding: 15px 18px;
            border-bottom: 1px solid #e5e7eb;
        }

            .details-section-header h6 {
                margin: 0;
                font-size: 17px;
                font-weight: 800;
                color: #111827;
            }

        .details-info-table {
            margin-bottom: 0;
        }

            .details-info-table th {
                width: 270px;
                color: #374151;
                font-weight: 700;
                background: #fcfcfc;
                vertical-align: middle;
            }

            .details-info-table td {
                color: #111827;
                vertical-align: middle;
            }

        .equipment-price-text {
            font-weight: 800;
            color: #111827;
        }

        .equipment-details-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 18px 24px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        @@media (max-width: 768px) {
            .equipment-details-header .d-flex,
            .equipment-summary-card .d-flex,
            .equipment-details-footer {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 14px;
            }

                .equipment-details-footer .btn {
                    width: 100%;
                }

            .details-info-table th {
                width: 45%;
            }
        }
    </style>
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Equipment Details</h3>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Equipments" asp-action="Index">Equipments</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="card equipment-details-card">

            <div class="equipment-details-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>
                            <i class="bi bi-tools me-2"></i>
                            @Display(Model.Name)
                        </h5>

                        <div class="equipment-details-subtitle">
                            Complete equipment profile, purchase, warranty and maintenance information
                        </div>
                    </div>

                    <div>
                        <span class="badge equipment-badge @GetAvailabilityBadgeClass(Model.AvailabilityStatus)">
                            @Display(Model.AvailabilityStatus)
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body">

                <partial name="_ResponsePartial" />

                <div class="equipment-summary-card">
                    <div class="d-flex align-items-center gap-3">
                        <div class="equipment-icon-box">
                            <i class="bi bi-wrench-adjustable"></i>
                        </div>

                        <div>
                            <div class="equipment-summary-name">
                                @Display(Model.Name)
                            </div>

                            <div class="equipment-summary-meta">
                                <span class="me-3">
                                    <i class="bi bi-tag me-1"></i>
                                    @Display(Model.CategoryName)
                                </span>

                                <span class="me-3">
                                    <i class="bi bi-upc-scan me-1"></i>
                                    @Display(Model.SerialNumber)
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt me-1"></i>
                                    @Display(Model.Location)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-info-circle me-2"></i>
                            Basic Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Name</th>
                                    <td>@Display(Model.Name)</td>
                                </tr>
                                <tr>
                                    <th>Category</th>
                                    <td>
                                        <span class="badge bg-primary equipment-badge">
                                            @Display(Model.CategoryName)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Serial Number</th>
                                    <td>@Display(Model.SerialNumber)</td>
                                </tr>
                                <tr>
                                    <th>Barcode</th>
                                    <td>@Display(Model.Barcode)</td>
                                </tr>
                                <tr>
                                    <th>Price</th>
                                    <td>
                                        <span class="equipment-price-text">
                                            ৳ @Model.Price.ToString("N2")
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Availability</th>
                                    <td>
                                        <span class="badge equipment-badge @GetAvailabilityBadgeClass(Model.AvailabilityStatus)">
                                            @Display(Model.AvailabilityStatus)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Condition</th>
                                    <td>
                                        <span class="badge equipment-badge @GetConditionBadgeClass(Model.Condition)">
                                            @Display(Model.Condition)
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-calendar-check me-2"></i>
                            Purchase / Warranty Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Purchase Date</th>
                                    <td>@DisplayDate(Model.PurchaseDate)</td>
                                </tr>
                                <tr>
                                    <th>Warranty Expiry Date</th>
                                    <td>@DisplayDate(Model.WarrantyExpiryDate)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-gear me-2"></i>
                            Maintenance Information
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Last Maintenance Date</th>
                                    <td>@DisplayDate(Model.LastMaintenanceDate)</td>
                                </tr>
                                <tr>
                                    <th>Maintenance Interval Days</th>
                                    <td>@DisplayNumber(Model.MaintenanceIntervalDays)</td>
                                </tr>
                                <tr>
                                    <th>Next Maintenance Date</th>
                                    <td>@DisplayDate(Model.NextMaintenanceDate)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="details-section-card">
                    <div class="details-section-header">
                        <h6>
                            <i class="bi bi-card-text me-2"></i>
                            Location / Description
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered details-info-table">
                            <tbody>
                                <tr>
                                    <th>Location</th>
                                    <td>@Display(Model.Location)</td>
                                </tr>
                                <tr>
                                    <th>Description</th>
                                    <td>@Display(Model.Description)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="equipment-details-footer">
                <a asp-area="Admin"
                   asp-controller="Equipments"
                   asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Equipments
                </a>

                <a asp-area="Admin"
                   asp-controller="Equipments"
                   asp-action="Update"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Equipment
                </a>
            </div>

        </div>

    </div>
</div>