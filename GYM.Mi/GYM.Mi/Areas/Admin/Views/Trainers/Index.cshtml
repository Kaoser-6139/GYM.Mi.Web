@{
    ViewData["Title"] = "Trainers";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">

    <style>
        .trainer-card {
            border: none;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        }

        .trainer-card-header {
            background: linear-gradient(135deg,#667eea,#764ba2);
            color: white;
            padding: 22px 24px;
        }

            .trainer-card-header h5 {
                color: white;
                font-size: 24px;
                font-weight: 600;
                margin: 0;
            }

        .trainer-table th {
            font-size: 16px;
            font-weight: 700;
            vertical-align: middle;
            color: #111;
        }

        .trainer-table td {
            vertical-align: middle;
            font-size: 15px;
            color: #222;
        }

        .trainer-name {
            font-weight: 700;
            color: #111;
        }

        .trainer-student-badge {
            background-color: #0dcaf0;
            color: #000;
            padding: 7px 13px;
            border-radius: 6px;
            font-weight: 700;
            display: inline-block;
            min-width: 42px;
            text-align: center;
        }

        .trainer-action-btn {
            border-radius: 6px;
            font-weight: 600;
            padding: 7px 14px;
        }

        .trainer-empty-note {
            color: #6c757d;
            font-size: 15px;
        }

        div.dt-container .dt-search input {
            border-radius: 6px;
            border: 1px solid #ced4da;
            padding: 6px 10px;
        }

        div.dt-container .dt-length select {
            border-radius: 6px;
            border: 1px solid #ced4da;
            padding: 5px 8px;
        }

        .dt-buttons .dt-button {
            border-radius: 6px !important;
            border: 1px solid #dee2e6 !important;
            background: #ffffff !important;
            color: #222 !important;
            padding: 6px 12px !important;
            margin-right: 5px !important;
            font-weight: 500;
        }

            .dt-buttons .dt-button:hover {
                background: #f1f3f5 !important;
            }
    </style>
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Trainers</h3>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Home</a>
                    </li>
                    <li class="breadcrumb-item active">Trainers</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="card trainer-card">

            <div class="trainer-card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5>
                        <i class="bi bi-person-workspace me-2"></i>
                        Trainer Directory
                    </h5>

                    <a asp-area="Admin"
                       asp-controller="Employees"
                       asp-action="Add"
                       class="btn btn-light btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Employee
                    </a>
                </div>
            </div>

            <div class="card-body">

                <partial name="_ResponsePartial" />

                <div class="table-responsive">
                    <table id="trainers" class="table table-bordered table-hover align-middle trainer-table w-100">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th class="text-center">Students</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody></tbody>

                        <tfoot>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th class="text-center">Students</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <script>
        $(function () {

            $("#trainers").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                scrollX: true,
                autoWidth: false,

                lengthMenu: [
                    [10, 25, 50],
                    [10, 25, 50]
                ],

                layout: {
                    topStart: 'buttons',
                    topEnd: 'search'
                },

                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],

                ajax: {
                    url: "/Admin/Trainers/GetTrainersJsonData",
                    type: "POST",
                    contentType: "application/json",
                    data: function (d) {
                        d.SearchItem = {};
                        return JSON.stringify(d);
                    }
                },

                columnDefs: [
                    {
                        targets: 0,
                        render: function (data) {
                            return `<span class="trainer-name">${data}</span>`;
                        }
                    },
                    {
                        targets: 3,
                        className: "text-center",
                        render: function (data) {
                            return `<span class="trainer-student-badge">${data}</span>`;
                        }
                    },
                    {
                        orderable: false,
                        targets: -1,
                        className: "text-center",
                        render: function (data, type, row) {
                            return `
                                <a class="btn btn-primary btn-sm trainer-action-btn"
                                   href="/Admin/Trainers/ManageStudents/${data}">
                                    <i class="bi bi-people me-1"></i>
                                    Manage Students
                                </a>
                            `;
                        }
                    }
                ],

                language: {
                    emptyTable: "No trainers found.",
                    zeroRecords: "No matching trainers found."
                }
            });

        });
    </script>
}