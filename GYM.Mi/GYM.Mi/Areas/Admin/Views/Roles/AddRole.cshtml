@using GYM.Mi.Areas.Admin.Models
@model AddRoleModel
@{
    ViewData["Title"] = "Add Role";
}

@section Styles
{
    <style>
        body {
            background: #f3f4f8;
        }

        .card-form {
            border-radius: 18px;
            border: 1.5px solid #e0e7ef;
            background: #fff;
            box-shadow: 0 3px 16px rgba(76, 70, 200, .10);
        }

        .card-form-header {
            background: linear-gradient(120deg, #6e7ff3 0%, #8262e3 60%, #a354e7 100%);
            color: #fff;
            padding: 28px 34px;
            border-radius: 18px 18px 0 0;
        }

            .card-form-header h4 {
                font-weight: 700;
                margin-bottom: 4px;
                letter-spacing: 0.01em;
            }

            .card-form-header p {
                margin: 0;
                font-size: 15px;
                opacity: 0.96;
                font-weight: 500;
            }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            color: #7555cf;
            letter-spacing: .09em;
            margin-bottom: 8px;
        }

        .form-label, .form-floating > label {
            font-size: 14px;
            font-weight: 600;
            color: #534ea1;
            letter-spacing: .03em;
        }

        .form-control, .form-select {
            border-radius: 8px !important;
            border: 1.3px solid #dedaf8;
            font-size: 15px;
        }

            .form-control:focus, .form-select:focus {
                border-color: #946af6;
                box-shadow: 0 0 0 2px #e7e6fd;
            }

        .btn-primary-gradient {
            background: linear-gradient(135deg, #5f5fd6 0%, #7c3aed 65%, #f15aa7 100%);
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 1.07rem;
            border-radius: 25px;
            padding: 10px 34px;
            letter-spacing: 0.04em;
            box-shadow: 0 2px 8px rgba(60,40,180,0.13);
            transition: filter 0.18s;
        }

            .btn-primary-gradient:hover, .btn-primary-gradient:focus {
                filter: brightness(1.08);
                color: #fff;
            }

        .btn-outline-secondary {
            border-radius: 25px;
            border-width: 1.3px;
            color: #8874b7;
            font-weight: 600;
        }

            .btn-outline-secondary:hover {
                background: #fafbff;
                border-color: #b783f3;
                color: #6434b2;
            }

        .app-content-header {
            padding-bottom: 14px;
        }

        .divider-header {
            border-bottom: 1px solid #ebeaff;
        }

        .form-text, .text-muted {
            color: #6671b3 !important;
            font-size: 12px;
            margin-top: 0.4em;
        }

        .text-danger {
            font-size: 13px;
        }
    </style>
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0" style="color:#472ea8;">Add Role</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end" style="background:transparent;">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" style="color:#4f46e5;">Home</a>
                    </li>
                    <li class="breadcrumb-item active" style="color:#8f7ccd;">Add Role</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!--end::App Content Header-->

<div class="divider-header mb-3"></div>

<!--begin::App Content-->
<div class="app-content" style="background:#f3f4f8; padding:36px 0;">
    <div class="container-fluid">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-7 col-xl-6">
                <div class="card shadow-sm card-form">
                    <div class="card-form-header">
                        <h4 class="mb-1">Add Role</h4>
                        <p>Create a new user with a role, or assign a role to an email.</p>
                    </div>

                    <form asp-antiforgery="true"
                          asp-area="Admin"
                          asp-controller="Roles"
                          asp-action="AddRole"
                          method="post"
                          class="p-4 p-md-5">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <!-- User -->
                        <div class="mb-3">
                            <div class="section-title">User</div>
                            <div class="form-floating">
                                <input type="email"
                                       class="form-control"
                                       asp-for="Email"
                                       placeholder="name@example.com" />
                                <label asp-for="Email">User Email</label>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text mt-1 text-muted small">
                                Provide a valid email address. If the user does not exist, an account will be created.
                            </div>
                        </div>

                        <!-- Security -->
                        <div class="mt-4 mb-2 section-title">Security</div>

                        <div class="form-floating mb-3">
                            <input type="password"
                                   class="form-control"
                                   asp-for="Password"
                                   placeholder="Password" />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text mt-1 text-muted small">
                                Use a strong password for new users.
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <input type="password"
                                   class="form-control"
                                   asp-for="ConfirmPassword"
                                   placeholder="Confirm password" />
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Role -->
                        <div class="mt-2 mb-2 section-title">Role</div>

                        <div class="form-floating mb-4">
                            <select class="form-select"
                                    asp-for="Role">
                                <option value="">-- Select Role --</option>
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="Trainer">Trainer</option>
                                <!-- More roles as needed -->
                            </select>
                            <label asp-for="Role">Role</label>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                            <div class="form-text mt-1 text-muted small">
                                Choose which role this user should have.
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row gap-3 mt-3">
                            <button type="submit"
                                    class="btn btn-lg btn-primary-gradient flex-fill">
                                Add Role
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Roles"
                               asp-action="Index"
                               class="btn btn-lg btn-outline-secondary flex-fill">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end::App Content-->
@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}





