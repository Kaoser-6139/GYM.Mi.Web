@using GYM.Mi.Areas.Admin.Models
@model List<UserRoleViewModel>
@{
    ViewData["Title"] = "Index";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
    <style>
        .table thead th {
            background: #f6f8fc;
            font-weight: 600;
            color: #444;
            letter-spacing: 0.03rem;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background: #f8f9fc;
        }

        .badge-role {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            border-radius: 4px;
            padding: 4px 12px;
            font-size: 13px;
            font-weight: 500;
            margin-right: 6px;
            display: inline-block;
        }

        .table-actions {
            display: flex;
            gap: 12px;
            justify-content: flex-start;
            align-items: center;
        }

        .btn-custom {
            border: none;
            font-size: 1rem;
            border-radius: 25px;
            padding: 6px 28px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            transition: background 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 6px rgba(80,0,150,0.04);
        }

        .btn-edit {
            background: linear-gradient(135deg, #4e54c8 0%, #8f94fb 100%);
            color: #fff;
        }

            .btn-edit:hover {
                background: linear-gradient(135deg, #21d4fd 0%, #b721ff 100%);
                color: #fff;
            }

        .btn-delete {
            background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
            color: #fff;
        }

            .btn-delete:hover {
                background: linear-gradient(135deg, #ff9068 0%, #fd746c 100%);
                color: #fff;
            }

        .table-actions .btn i {
            margin-right: 4px;
        }
    </style>
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0" style="color: #1a2332;">Admin Directory</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end" style="background: transparent;">
                    <li class="breadcrumb-item"><a href="#" style="color: #4a90e2;">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: #6c757d;">Admin Directory</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content" style="background: #ffffff; padding: 40px 0;">
    <div class="container-fluid">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-10">
                <div class="card shadow-sm" style="border-radius: 12px; border: 1px solid #e0e0e0;">
                    <div class="card-header text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; padding: 24px; border-radius: 12px 12px 0 0;">
                        <h4 class="mb-1" style="font-weight: 600;">Admin Directory</h4>
                        <p class="mb-0" style="font-size: 14px; opacity: 0.9;">All admin, manager and trainer users listed below</p>
                    </div>
                    <div class="table-responsive" style="padding:32px;">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="adminDirectoryTable" class="table table-striped align-middle mb-0" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Roles</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var user in Model)
                                    {
                                        <tr>
                                            <td style="font-weight: 500; color:#2b2d42;">@user.Name</td>
                                            <td>@user.Email</td>
                                            <td>
                                                @foreach (var role in user.Roles)
                                                {
                                                    <span class="badge-role">@role</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="table-actions">
                                                    @* <a href="@Url.Action("Delete", "Roles", new { id = user.Id, area = "Admin" })"
                                                       class="btn btn-custom btn-delete"
                                                       title="Delete"
                                                       onclick="return confirm('Are you sure you want to delete this user?');">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </a> *@
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No users found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#adminDirectoryTable').DataTable({
                paging: true,
                searching: true,
                info: false,
                ordering: true,
                responsive: true,
                columnDefs: [{ orderable: false, targets: 3 }]
            });
        });
    </script>
}





